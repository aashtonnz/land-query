  {
   "id": "Q3",
   "name": "Nearest sewer is old and in poor condition",
   "question": "Parcels whose nearest wastewater pipe (within 20 m) was installed before 1980 and has KCDC condition grade 4 or 5 (grade 0 treated as not assessed). Where pipes tie as nearest, the worst grade counts. Caution: KCDC records far more pipes as installed in 1979 and 1980 than in any other year, so many 1979 dates may be placeholders.",
   "sql": "SELECT unit_id, appellation, ww_pipe_id, ww_pipe_dist_m, ww_pipe_material, ww_pipe_year, ww_pipe_condition_grade FROM units WHERE coverage_pct >= 99 AND area_m2 >= 20 AND ww_pipe_dist_m <= 20 AND ww_pipe_year < 1980 AND ww_pipe_condition_grade >= 4 ORDER BY ww_pipe_condition_grade DESC, ww_pipe_year",
