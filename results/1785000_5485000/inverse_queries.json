  {
   "id": "Q1",
   "name": "Gravity-serviceable infill candidates",
   "question": "High or General Residential parcels of at least 800 m\u00b2 (not stacked with another zone over 10% of the parcel), under 25% covered by 2021 buildings, 90th-percentile slope under 10\u00b0, outside every KCDC flood layer (the 2021 District Plan overlay and the newer modelled extents), and a wastewater manhole with a recorded invert within 30 m that sits at least 1 m below the parcel's lowest ground (where manholes tie as nearest, the deepest invert counts). Title type and easement count returned (cross-lease and unit titles complicate subdivision); freehold first.",
   "sql": "SELECT unit_id, appellation, title_types, easements_n, area_m2, building_2021_m2, slope_p90_deg, zones, ww_mh_id, ww_mh_dist_m, ww_head_ground_min_minus_invert_m FROM units WHERE coverage_pct >= 99 AND area_m2 >= 20 AND lidar_coverage_pct >= 99 AND (json_extract(zones,'$.\"High Density Residential Zone\"')::DOUBLE >= 90 OR json_extract(zones,'$.\"General Residential Zone\"')::DOUBLE >= 90) AND zones_total_pct - greatest(coalesce(json_extract(zones,'$.\"High Density Residential Zone\"')::DOUBLE, 0), coalesce(json_extract(zones,'$.\"General Residential Zone\"')::DOUBLE, 0)) < 10 AND area_m2 >= 800 AND building_2021_m2 < 0.25*area_m2 AND slope_p90_deg < 10 AND ovl_flood_hazard IS NULL AND flood_river_corridor IS NULL AND flood_stream_corridor IS NULL AND flood_overflow_path IS NULL AND flood_residual_overflow IS NULL AND flood_fill_control IS NULL AND flood_storage IS NULL AND flood_ponding IS NULL AND flood_residual_ponding IS NULL AND flood_shallow_surface IS NULL AND ww_mh_dist_m <= 30 AND ww_head_ground_min_minus_invert_m >= 1 ORDER BY (title_types = 'Freehold') DESC, area_m2 DESC",
