  {
   "id": "Q4",
   "name": "Ground level changed since 2021",
   "question": "Parcels where some 1 m cell of LiDAR ground changed by more than 1 m between the 2021 and 2024\u201325 surveys, and the parcel's mean ground changed by more than 0.3 m after removing its block's epoch offset (the median change on flat, open, unbuilt ground in the block). Ground surfaces exclude buildings, so this is mostly earthworks, but it may also be vegetation classed as ground or a survey artefact (unverified, see T-29).",
   "sql": "SELECT unit_id, appellation, area_m2, building_2021_m2, dz_2021_2025_mean_m, coalesce(lidar_epoch_offset_block_m, 0.08) AS epoch_offset_m, round(dz_2021_2025_mean_m - coalesce(lidar_epoch_offset_block_m, 0.08), 3) AS dz_mean_corrected_m, dz_2021_2025_absmax_m FROM units WHERE coverage_pct >= 99 AND area_m2 >= 20 AND lidar_coverage_pct >= 99 AND dz_2021_2025_absmax_m > 1 AND abs(dz_2021_2025_mean_m - coalesce(lidar_epoch_offset_block_m, 0.08)) > 0.3 ORDER BY abs(dz_2021_2025_mean_m - coalesce(lidar_epoch_offset_block_m, 0.08)) DESC",
